{
  "name": "eslint-plugin-exceptions",
  "version": "0.0.0-development",
  "description": "Approve a fixed number of lint violations per file with approvals.json. Works with ESLint (processor) and oxlint (CLI).",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "eslint-plugin-exceptions": "src/cli.js",
    "eslint-exceptions": "src/cli.js",
    "eslint-exceptions-oxlint-lsp": "src/oxlint-lsp.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node test/test.js && node test/lsp.test.js && node test/release.test.js && node test/site.test.js",
    "prepublishOnly": "npm test",
    "build:site": "node site/build.mjs",
    "dev:site": "node site/build.mjs --serve",
    "og": "node site/og/render.js"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "exceptions",
    "approvals",
    "lint",
    "technical-debt",
    "oxlint",
    "oxc",
    "baseline"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=8.0.0",
    "oxlint": ">=1.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "eslint": "^8.57.0",
    "eslint-linter-browserify": "10.14.0",
    "highlight.js": "11.12.0",
    "marked": "18.2.0",
    "oxlint": "^1.95.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assuncaocharles/eslint-plugin-exceptions.git"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "homepage": "https://assuncaocharles.github.io/eslint-plugin-exceptions/",
  "bugs": {
    "url": "https://github.com/assuncaocharles/eslint-plugin-exceptions/issues"
  }
}
