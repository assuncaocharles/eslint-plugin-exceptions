{
  "name": "eslint-plugin-exceptions",
  "version": "1.2.0",
  "description": "Approve a fixed number of lint violations per file with approvals.json. Works with ESLint (processor) and oxlint (CLI).",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "eslint-plugin-exceptions": "./src/cli.js",
    "eslint-exceptions": "./src/cli.js",
    "eslint-exceptions-oxlint-lsp": "./src/oxlint-lsp.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node test/test.js && node test/lsp.test.js",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "exceptions",
    "approvals",
    "lint",
    "technical-debt",
    "oxlint",
    "oxc",
    "baseline"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=8.0.0",
    "oxlint": ">=1.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "oxlint": "^1.95.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assuncaocharles/eslint-plugin-exceptions.git"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "homepage": "https://github.com/assuncaocharles/eslint-plugin-exceptions#readme",
  "bugs": {
    "url": "https://github.com/assuncaocharles/eslint-plugin-exceptions/issues"
  }
}
