{
  "name": "eslint-plugin-exceptions",
  "version": "1.1.0",
  "description": "ESLint plugin that allows approved exceptions per file based on an approvals.json configuration",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "eslint-plugin-exceptions": "./src/cli.js",
    "eslint-exceptions": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node test/test.js",
    "prepublishOnly": "npm test",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "exceptions",
    "approvals",
    "lint",
    "technical-debt"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": ""
  }
}
